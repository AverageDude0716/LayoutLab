<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".explore"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--top-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start">

                <Button
                    android:id="@+id/btn_backExplore"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:backgroundTint="@android:color/transparent"
                    android:foreground="@drawable/back_icon" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logoHome"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:foreground="@drawable/logo_transparent"
                    app:backgroundTint="@android:color/transparent"
                    android:clickable="false"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="start">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <Button
                        android:id="@+id/btn_profileExplore"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:backgroundTint="@android:color/transparent"
                        android:foreground="@drawable/profile_icon" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:text="Explore"
                        android:textSize="25sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <!--search-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_margin="5dp">

                    <LinearLayout
                        android:layout_width="275dp"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:padding="5dp"
                        android:background="@drawable/search">

                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/search_icon"/>


                        <EditText
                            android:id="@+id/etx_searchExplore"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="@string/search"
                            android:inputType="text"
                            android:padding="3dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="5sp"
                            android:textColorHint="@color/black"
                            android:textSize="20sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingLeft="40dp"
                    android:paddingRight="40dp">

                    <!--saved design-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:padding="5dp"
                        android:background="@drawable/scrollview_items">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:orientation="vertical"
                            android:layout_margin="10dp"
                            android:padding="2dp"
                            android:background="@drawable/scrollview_items">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/exploredesign1"
                                android:clipToOutline="true"
                                android:background="@drawable/library_item"
                                android:scaleType="fitXY"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="8"
                                android:text="1034"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textAlignment="textEnd"
                                android:textColor="@color/black"
                                android:padding="5dp"/>

                            <Button
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="30dp"
                                android:padding="5dp"
                                android:backgroundTint="@android:color/transparent"
                                android:foreground="@drawable/like" />

                        </LinearLayout>

                    </LinearLayout>

                    <!--drafts-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:padding="5dp"
                        android:background="@drawable/scrollview_items">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:orientation="vertical"
                            android:layout_margin="10dp"
                            android:padding="2dp"
                            android:background="@drawable/scrollview_items">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/exploredesign2"
                                android:clipToOutline="true"
                                android:background="@drawable/library_item"
                                android:scaleType="fitXY"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="8"
                                android:text="1346"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textAlignment="textEnd"
                                android:textColor="@color/black"
                                android:padding="5dp"/>

                            <Button
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="30dp"
                                android:padding="5dp"
                                android:backgroundTint="@android:color/transparent"
                                android:foreground="@drawable/like" />

                        </LinearLayout>

                    </LinearLayout>

                    <!--explore-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:padding="5dp"
                        android:background="@drawable/scrollview_items">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:orientation="vertical"
                            android:layout_margin="10dp"
                            android:padding="2dp"
                            android:background="@drawable/scrollview_items">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/exploredesign3"
                                android:clipToOutline="true"
                                android:background="@drawable/library_item"
                                android:scaleType="fitXY"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="8"
                                android:text="908"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textAlignment="textEnd"
                                android:textColor="@color/black"
                                android:padding="5dp"/>

                            <Button
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="30dp"
                                android:padding="5dp"
                                android:backgroundTint="@android:color/transparent"
                                android:foreground="@drawable/like" />

                        </LinearLayout>

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:padding="5dp"
                        android:background="@drawable/scrollview_items">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:orientation="vertical"
                            android:layout_margin="10dp"
                            android:padding="2dp"
                            android:background="@drawable/scrollview_items">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/exploredesign4"
                                android:clipToOutline="true"
                                android:background="@drawable/library_item"
                                android:scaleType="fitXY"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="8"
                                android:text="1127"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textAlignment="textEnd"
                                android:textColor="@color/black"
                                android:padding="5dp"/>

                            <Button
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="30dp"
                                android:padding="5dp"
                                android:backgroundTint="@android:color/transparent"
                                android:foreground="@drawable/like" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>